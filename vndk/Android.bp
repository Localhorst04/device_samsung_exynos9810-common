cc_prebuilt_library_shared {
    name: "libion-tm",
    vendor: true,
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["v34/arm/libion-tm.so"],
        },
        android_arm64: {
            srcs: ["v34/arm64/libion-tm.so"],
        },
    },
    compile_multilib: "both",
}

